# Copia este archivo a .env y ajusta los valores para desarrollo local.
# En producción, estas variables se inyectan vía el sistema de despliegue,
# nunca vía un archivo .env commiteado.

# ---- General ----
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# URL pública del panel (la que abre un humano en su navegador, ej. desde
# el enlace seguro de un email) — no confundir con API_URL del frontend.
FRONTEND_URL=http://localhost:3000

# ---- Base de datos (PostgreSQL) ----
POSTGRES_USER=gestoria
POSTGRES_PASSWORD=gestoria
POSTGRES_DB=gestoria
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Construida a partir de las variables anteriores; útil para override directo.
DATABASE_URL=postgresql+asyncpg://gestoria:gestoria@db:5432/gestoria

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# Solo la usa el servidor de Next.js (Route Handlers), nunca el navegador.
# Ver ADR 0007 (backend-for-frontend). docker-compose la sobreescribe al
# hostname interno "backend"; este valor es para correr el frontend suelto.
API_URL=http://localhost:8000/api/v1

# ---- Punto de extensión futuro (no usado todavía) ----
# ANTHROPIC_API_KEY=
